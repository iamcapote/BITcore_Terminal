{
  "meta": {
    "version": "2025-10-19",
    "source": "legacy-css-synthesis",
    "description": "Design token baseline for Hacker, Modern, and Retro skins."
  },
  "colors": {
    "hacker": {
      "bg-primary": "#050608",
      "bg-secondary": "#0B101A",
      "bg-surface": "#111927",
      "fg-primary": "#E6EDF7",
      "fg-secondary": "#8FB0D8",
      "muted": "#5F7292",
      "accent-primary": "#14F1FF",
      "accent-secondary": "#C592FF",
      "border": "#1E2A3C",
      "focus-ring": "#4FD1C5",
      "success": "#35EBAE",
      "warning": "#F7C948",
      "danger": "#FF5470"
    },
    "modern": {
      "bg-primary": "#0F172A",
      "bg-secondary": "#111C33",
      "bg-surface": "#162440",
      "fg-primary": "#E2E8F0",
      "fg-secondary": "#94A3B8",
      "muted": "#64748B",
      "accent-primary": "#38BDF8",
      "accent-secondary": "#8B5CF6",
      "border": "#1F2937",
      "focus-ring": "#38BDF8",
      "success": "#22C55E",
      "warning": "#F59E0B",
      "danger": "#EF4444"
    },
    "retro": {
      "bg-primary": "#008080",
      "bg-secondary": "#C0C0C0",
      "bg-surface": "#F2F2F2",
      "fg-primary": "#000000",
      "fg-secondary": "#000080",
      "muted": "#4F4F4F",
      "accent-primary": "#FFDE59",
      "accent-secondary": "#FD6B68",
      "border": "#000000",
      "focus-ring": "#0000FF",
      "success": "#008000",
      "warning": "#FFA500",
      "danger": "#FF0000"
    }
  },
  "typography": {
    "font-family-mono": "\"IBM Plex Mono\", \"Fira Code\", \"SFMono-Regular\", monospace",
    "font-family-sans": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "font-family-retro": "\"MS Sans Serif\", \"Chicago\", sans-serif",
    "font-size-xs": "12px",
    "font-size-sm": "13px",
    "font-size-base": "14px",
    "font-size-lg": "16px",
    "font-size-xl": "20px",
    "line-height-tight": 1.2,
    "line-height-regular": 1.4,
    "line-height-relaxed": 1.6
  },
  "spacing": {
    "unit": "4px",
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "24px",
    "3xl": "32px"
  },
  "radii": {
    "none": "0px",
    "sm": "2px",
    "md": "4px",
    "lg": "8px",
    "full": "9999px"
  },
  "shadows": {
    "flat": "none",
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.1)",
    "lg": "0 12px 24px -12px rgba(0,0,0,0.45)"
  },
  "motion": {
    "cursor-pulse": "400ms ease-in-out",
    "transition-fast": "120ms ease-out",
    "transition-medium": "180ms ease-in-out",
    "transition-slow": "240ms ease-in-out"
  }
}
